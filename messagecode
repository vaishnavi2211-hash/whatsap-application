  .composer {
    background: var(--bg); padding: 10px 16px; display: flex; align-items: center; gap: 10px; flex-shrink: 0;
  }
  .composer .emoji { background: none; border: 0; font-size: 24px; cursor: pointer; }
  .composer input {
    flex: 1; height: 42px; border: 0; border-radius: 8px; padding: 0 14px; font-size: 15px; background: #fff; color: var(--text);
  }
  .composer input:focus { outline: 2px solid var(--green); }
