  /* ---------- Mobile ---------- */
  @media (max-width: 800px) {
    .app { grid-template-columns: 1fr; }
    .conv { display: none; }
    .app.open .side { display: none; }
    .app.open .conv { display: flex; }
    .back { display: block; }
    .msg { max-width: 82%; }
    .messages { padding: 16px 4%; }
