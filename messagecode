</style>
</head>
<body>
<div class="app" id="app">

  <!-- Sidebar -->
  <aside class="side">
    <div class="side-head">
      <span class="side-title">Chats</span>
      <div class="avatar" style="background:#00a884">Me</div>
    </div>
    <div class="search"><input id="search" type="text" placeholder="Search or start a new chat"></div>
    <div class="list" id="list"></div>
  </aside>

  <!-- Conversation -->
  <section class="conv">
    <div class="conv-head">
      <button class="back" id="back" aria-label="Back">←</button>
      <div class="avatar" id="hAvatar"></div>
      <div>
        <div class="name" id="hName"></div>
        <div class="status" id="hStatus">online</div>
      </div>
    </div>
    <div class="messages" id="messages"></div>
    <div class="composer">
      <button class="emoji" id="emoji" aria-label="Emoji">😊</button>
      <input id="input" type="text" placeholder="Type a message" autocomplete="off">
      <button class="send" id="send" aria-label="Send">
        <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
      </button>
    </div>
  </section>
</div>

<script>
  // ---------- Data ----------
  const colors = ['#7e57c2', '#e91e63', '#ff9800', '#009688', '#3f51b5', '#795548'];
  const chats = [
    { id: 1, name: 'Rahul', last: 'Are we meeting today?', time: '10:42', unread: 2,
      msgs: [['in', 'Hey bro!', '10:38'], ['out', 'Hey Rahul, what\'s up?', '10:39'], ['in', 'Are we meeting today?', '10:42']] },
    { id: 2, name: 'Mom', last: 'Come home early 🙂', time: '09:15', unread: 0,
      msgs: [['in', 'Did you eat lunch?', '09:10'], ['out', 'Yes mom', '09:12'], ['in', 'Come home early 🙂', '09:15']] },
    { id: 3, name: 'College Group', last: 'Sneha: Assignment due tomorrow', time: 'Yesterday', unread: 5,
      msgs: [['in', 'Sneha: Assignment due tomorrow', '18:20']] },
    { id: 4, name: 'Priya', last: 'Thanks!', time: 'Yesterday', unread: 0,
      msgs: [['out', 'Sent you the notes', '16:02'], ['in', 'Thanks!', '16:05']] },
    { id: 5, name: 'Work Team', last: 'Meeting at 3 PM', time: 'Monday', unread: 0,
      msgs: [['in', 'Meeting at 3 PM', '11:00']] }
  ];
  const replies = ['Okay 👍', 'Haha nice', 'Sure bro', 'Call me later', 'Let me check and tell you', 'Cool!', 'Alright'];
  let current = null;

  const $ = id => document.getElementById(id);
  const list = $('list'), messages = $('messages'), input = $('input');

  const initials = n => n.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
  const now = () => new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
  const esc = s => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // ---------- Render chat list ----------
  function renderList(filter = '') {
    list.innerHTML = '';
    chats.filter(c => c.name.toLowerCase().includes(filter.toLowerCase())).forEach(c => {
      const el = document.createElement('div');
      el.className = 'chat' + (current && current.id === c.id ? ' active' : '');
      el.innerHTML = `
        <div class="avatar" style="background:${colors[c.id % colors.length]}">${initials(c.name)}</div>
        <div class="info">
          <div class="row1"><span class="name">${esc(c.name)}</span><span class="time">${c.time}</span></div>
          <div class="row1"><span class="last">${esc(c.last)}</span>${c.unread ? `<span class="badge">${c.unread}</span>` : ''}</div>
        </div>`;
      el.onclick = () => openChat(c.id);
      list.appendChild(el);
    });
  }

  // ---------- Render conversation ----------
  function bubble(type, text, time) {
    const d = document.createElement('div');
    d.className = 'msg ' + type;
    d.innerHTML = `${esc(text)}<span class="meta">${time}${type === 'out' ? '<span class="tick">✓✓</span>' : ''}</span>`;
    messages.appendChild(d);
    messages.scrollTop = messages.scrollHeight;
    return d;
  }

  function openChat(id) {
    current = chats.find(c => c.id === id);
    current.unread = 0;
    $('hName').textContent = current.name;
    $('hAvatar').textContent = initials(current.name);
    $('hAvatar').style.background = colors[current.id % colors.length];
    $('hStatus').textContent = 'online';
    messages.innerHTML = '<div class="day">Today</div>';
    current.msgs.forEach(m => bubble(m[0], m[1], m[2]));
    $('app').classList.add('open');
    renderList($('search').value);
    input.focus();
  }

  // ---------- Send message ----------
  function send() {
    const text = input.value.trim();
    if (!text || !current) return;
    const t = now();
    current.msgs.push(['out', text, t]);
    current.last = text; current.time = t;
    bubble('out', text, t);
    input.value = '';
    renderList($('search').value);
    autoReply(current);
  }

  function autoReply(chat) {
    $('hStatus').textContent = 'typing...';
    setTimeout(() => {
      const text = replies[Math.floor(Math.random() * replies.length)];
      const t = now();
      chat.msgs.push(['in', text, t]);
      chat.last = text; chat.time = t;
      if (current && current.id === chat.id) {
        bubble('in', text, t);
        $('hStatus').textContent = 'online';
      } else chat.unread++;
      renderList($('search').value);
    }, 1200 + Math.random() * 1200);
  }

  // ---------- Events ----------
  $('send').onclick = send;
  input.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });
  $('emoji').onclick = () => { input.value += '😊'; input.focus(); };
  $('search').addEventListener('input', e => renderList(e.target.value));
  $('back').onclick = () => $('app').classList.remove('open');

  renderList();
  openChat(1);
</script>
</body>
</html>
