<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WhatsApp Chat</title>
<style>
  :root {
    --green: #00a884;
    --green-dark: #008069;
    --panel: #ffffff;
    --bg: #f0f2f5;
    --chat-bg: #efeae2;
    --out: #d9fdd3;
    --in: #ffffff;
    --text: #111b21;
    --muted: #667781;
    --line: #e9edef;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    background: #d1d7db;
    height: 100vh;
    display: flex; align-items: center; justify-content: center;
    color: var(--text);
  }
  .app {
    width: 100%; max-width: 1400px; height: 100vh;
    display: grid; grid-template-columns: 380px 1fr;
    background: var(--panel); overflow: hidden;
    box-shadow: 0 6px 18px rgba(11,20,26,.15);
  }
  @media (min-width: 1500px) { .app { height: calc(100vh - 40px); } }

  /* ---------- Sidebar ---------- */
  .side { border-right: 1px solid var(--line); display: flex; flex-direction: column; min-height: 0; }
  .side-head {
    height: 60px; background: var(--bg); padding: 0 16px;
    display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
  }
  .avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 600; font-size: 16px;
  }
  .side-title { font-size: 20px; font-weight: 600; }
  .search { padding: 8px 12px; border-bottom: 1px solid var(--line); flex-shrink: 0; }
  .search input {
    width: 100%; height: 36px; border: 0; border-radius: 8px; background: var(--bg);
    padding: 0 14px; font-size: 14px; color: var(--text);
  }
  .search input:focus { outline: 2px solid var(--green); }
  .list { overflow-y: auto; flex: 1; }
  .chat {
    display: flex; gap: 14px; align-items: center; padding: 12px 16px; cursor: pointer;
    border-bottom: 1px solid var(--line);
  }
  .chat:hover { background: #f5f6f6; }
  .chat.active { background: #f0f2f5; }
  .chat .info { flex: 1; min-width: 0; }
  .chat .row1 { display: flex; justify-content: space-between; align-items: baseline; }
  .chat .name { font-size: 16px; font-weight: 500; }
  .chat .time { font-size: 12px; color: var(--muted); }
  .chat .last {
    font-size: 14px; color: var(--muted); margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .badge {
    background: var(--green); color: #fff; font-size: 12px; font-weight: 600;
    border-radius: 12px; padding: 1px 7px; margin-left: 8px;
  }

  /* ---------- Conversation ---------- */
  .conv { display: flex; flex-direction: column; min-height: 0; background: var(--chat-bg); }
  .conv-head {
    height: 60px; background: var(--bg); padding: 0 16px; flex-shrink: 0;
    display: flex; align-items: center; gap: 14px; border-bottom: 1px solid var(--line);
  }
  .back { display: none; background: none; border: 0; font-size: 22px; cursor: pointer; color: var(--muted); }
  .conv-head .name { font-size: 16px; font-weight: 500; }
  .conv-head .status { font-size: 13px; color: var(--muted); }
  .messages {
    flex: 1; overflow-y: auto; padding: 20px 6%;
    display: flex; flex-direction: column; gap: 4px;
    background-image: radial-gradient(rgba(11,20,26,.04) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .day {
    align-self: center; background: #fff; color: var(--muted); font-size: 12.5px;
    padding: 5px 12px; border-radius: 8px; margin: 8px 0; box-shadow: 0 1px 1px rgba(11,20,26,.1);
  }
  .msg {
    max-width: 65%; padding: 6px 8px 6px 9px; border-radius: 8px; font-size: 14.5px; line-height: 1.4;
